[Unit]
Description=Tracky Scale 24/7 BlueZ Background Acquisition Daemon
Documentation=https://github.com/eggmasonvalue/tracky-mcp
After=bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tracky-daemon
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1

# Hardening / Sandboxing
ProtectSystem=strict
ReadWritePaths=/var/lib/tracky /root/.local/share/tracky
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
